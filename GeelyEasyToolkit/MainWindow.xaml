<Window x:Class="GeelyEasyToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GeelyEasyToolkit.Views"
        Title="Geely Easy Toolkit"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1C1F26">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#252932">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Geely Easy Toolkit"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center"/>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Ellipse
    x:Name="ConnectionIndicator"
    Width="12"
    Height="12"
    Fill="Red"
    Margin="0,0,10,0"/>

                    <TextBlock
    x:Name="ConnectionStatusText"
    Text="Не подключено"
    Foreground="White"
    FontSize="16"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Левое меню -->
        <Border Grid.Row="1"
                Background="#252932">

            <StackPanel Margin="15">

                <Button x:Name="DashboardButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="🏠 Dashboard"
        Click="DashboardButton_Click"/>

                <Button x:Name="ConnectionButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="🔌 Подключение"
        Click="ConnectionButton_Click"/>

                <Button x:Name="ApplicationsButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="📦 Приложения"
        Click="ApplicationsButton_Click"/>

                <Button x:Name="ProfilesButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="🚗 Профили"/>

                <Button x:Name="RepositoryButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="📁 Репозиторий"/>
                
                <Button x:Name="InstalledApplicationsButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="📱 Установленные"
        Click="InstalledApplicationsButton_Click"/>

                <Button x:Name="LogsButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="📄 Логи"/>

                <Button x:Name="SettingsButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="⚙ Настройки"/>

                <Button x:Name="DeveloperButton"
        Style="{DynamicResource NavigationButtonStyle}"
        Content="🛠 Разработчик"/>

            </StackPanel>

        </Border>

        <!-- Рабочая область -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="20"
                CornerRadius="10"
                Background="#2F3440">

            <ContentControl x:Name="MainContent"/>

        </Border>

        <!-- Нижняя строка -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#252932">

            <Grid Margin="15,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Подключите автомобиль через USB."
                    Foreground="White"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Grid.Column="1"
                    Text="v0.1 Alpha"
                    Foreground="Gray"
                    VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>