<Window x:Class="GeelyEasyToolkit.Views.RepositoryApplicationEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приложение репозитория"
        Width="650"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#2F3440"
        Foreground="White"
        ResizeMode="CanResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>


                <!-- Название -->

                <TextBlock Text="Название"
                           Margin="0,0,0,5"
                           Foreground="#C8CDD6"/>

                <TextBox x:Name="NameTextBox"
                         Height="36"
                         Padding="10"
                         Background="#252932"
                         Foreground="White"
                         BorderBrush="#596273"/>


                <!-- Категория -->

                <TextBlock Text="Категория"
                           Margin="0,15,0,5"
                           Foreground="#C8CDD6"/>

                <TextBox x:Name="CategoryTextBox"
                         Height="36"
                         Padding="10"
                         Background="#252932"
                         Foreground="White"
                         BorderBrush="#596273"/>


                <!-- Версия -->

                <TextBlock Text="Версия"
                           Margin="0,15,0,5"
                           Foreground="#C8CDD6"/>

                <TextBox x:Name="VersionTextBox"
                         Height="36"
                         Padding="10"
                         Background="#252932"
                         Foreground="White"
                         BorderBrush="#596273"/>


                <!-- Package -->

                <TextBlock Text="PackageName"
                           Margin="0,15,0,5"
                           Foreground="#C8CDD6"/>

                <TextBox x:Name="PackageNameTextBox"
                         Height="36"
                         Padding="10"
                         Background="#252932"
                         Foreground="White"
                         BorderBrush="#596273"/>


                <!-- APK -->

                <TextBlock Text="APK-файл"
                           Margin="0,15,0,5"
                           Foreground="#C8CDD6"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FileNameTextBox"
                             Height="36"
                             Padding="10"
                             Background="#252932"
                             Foreground="White"
                             BorderBrush="#596273"/>

                    <Button Grid.Column="1"
                            Content="Выбрать APK"
                            Width="120"
                            Height="36"
                            Margin="10,0,0,0"
                            Click="SelectApk_Click"/>

                </Grid>


                <!-- Совместимость -->

                <TextBlock Text="Совместимость"
                           Margin="0,15,0,8"
                           Foreground="#C8CDD6"/>

                <StackPanel Orientation="Horizontal">

                    <CheckBox x:Name="CityrayCheckBox"
                              Content="Cityray"
                              Margin="0,0,20,0"
                              Foreground="White"/>

                    <CheckBox x:Name="AtlasCheckBox"
                              Content="Atlas"
                              Margin="0,0,20,0"
                              Foreground="White"/>

                    <CheckBox x:Name="PrefaceCheckBox"
                              Content="Preface"
                              Foreground="White"/>

                </StackPanel>


                <!-- ADB -->

                <TextBlock Text="ADB-команды после установки"
                           Margin="0,20,0,5"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Введите команды без 'adb shell'. Программа добавит его автоматически."
                           Margin="0,0,0,10"
                           Foreground="#9EA5B3"
                           TextWrapping="Wrap"/>


                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AdbCommandTextBox"
                             Height="36"
                             Padding="10"
                             Background="#252932"
                             Foreground="White"
                             BorderBrush="#596273"/>

                    <Button Grid.Column="1"
                            Content="Добавить"
                            Width="100"
                            Height="36"
                            Margin="10,0,0,0"
                            Click="AddAdbCommand_Click"/>

                </Grid>


                <ListBox x:Name="AdbCommandsList"
                         Height="150"
                         Margin="0,10,0,0"
                         Background="#252932"
                         BorderBrush="#596273">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid Margin="5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Command}"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <Button Grid.Column="1"
                                        Content="Удалить"
                                        Width="80"
                                        Height="28"
                                        Margin="10,0,0,0"
                                        Click="RemoveAdbCommand_Click"/>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>


            </StackPanel>

        </ScrollViewer>


        <!-- Кнопки -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Отмена"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить"
                    Width="130"
                    Height="38"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>