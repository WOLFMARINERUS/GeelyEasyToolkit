<UserControl x:Class="GeelyEasyToolkit.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <!-- Основная область -->
            <RowDefinition Height="*"/>

            <!-- Команды ADB -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>

                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>

                <!-- Инструкция -->
                <RowDefinition Height="Auto"/>

                <!-- Данные подключения -->
                <RowDefinition Height="Auto"/>

                <!-- Кнопки -->
                <RowDefinition Height="Auto"/>

                <!-- Журнал -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- ЗАГОЛОВОК -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="Подключение автомобиля"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

                <TextBlock Text="Следуйте шагам мастера подключения."
                       Margin="0,10,0,25"
                       Foreground="LightGray"/>
                <TextBlock x:Name="ProfileText"
           Text="Профиль: не выбран"
           Foreground="#9EA5B3"
           FontSize="14"
           Margin="0,0,0,10"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- ИНСТРУКЦИЯ -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                Background="#3A4050"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="① Подключите автомобиль по USB"
                           FontSize="18"
                           Foreground="White"
                           Margin="0,5"/>

                    <TextBlock Text="② Включите зажигание"
                           FontSize="18"
                           Foreground="White"
                           Margin="0,5"/>

                    <TextBlock Text="③ Нажмите кнопку проверки"
                           FontSize="18"
                           Foreground="White"
                           Margin="0,5"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- ИНФОРМАЦИЯ ОБ УСТРОЙСТВЕ -->
            <!-- ================================================= -->

            <Grid Grid.Row="2"
              Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Button x:Name="CheckConnectionButton"
                        Content="Проверить подключение"
                        Width="240"
                        Height="45"
                        HorizontalAlignment="Left"
                        Click="CheckConnection_Click"/>

                    <Button Content="Диагностика ADB"
                        Width="240"
                        Height="45"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Click="Diagnostics_Click"/>
                    <Button Content="Активировать ADB Cityray"
        Width="240"
        Height="45"
        Margin="0,10,0,0"
        Click="ActivateAdb_Click"/>
                </StackPanel>


                <StackPanel Grid.Column="1"
                        Margin="25,0,0,0"
                        VerticalAlignment="Center">

                    <TextBlock x:Name="StatusText"
                           Text="Автомобиль не подключен."
                           FontSize="16"
                           Foreground="Orange"/>

                    <TextBlock x:Name="ModelText"
                           Text="Модель:"
                           Margin="0,5,0,0"
                           Foreground="White"/>

                    <TextBlock x:Name="ManufacturerText"
                           Text="Производитель:"
                           Foreground="White"/>

                    <TextBlock x:Name="AndroidText"
                           Text="Android:"
                           Foreground="White"/>

                    <TextBlock x:Name="BuildText"
                           Text="Build:"
                           Foreground="White"/>

                    <TextBlock x:Name="FirmwareText"
                           Text="Прошивка:"
                           Foreground="White"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- ЖУРНАЛ -->
            <!-- ================================================= -->

            <Grid Grid.Row="4">

                <Grid.RowDefinitions>

                    <!-- Заголовок журнала -->
                    <RowDefinition Height="Auto"/>

                    <!-- Сам журнал -->
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                       Text="Журнал диагностики"
                       Margin="0,5,0,8"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"/>


                <TextBox Grid.Row="1"
                     x:Name="DiagnosticsOutput"
                     Background="#252932"
                     Foreground="#D8DEE9"
                     BorderBrush="#596273"
                     BorderThickness="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"/>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- ADB КОМАНДЫ -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
            Background="#3A4050"
            Padding="12"
            Margin="0,12,0,0">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Предупреждение -->
                    <RowDefinition Height="Auto"/>

                    <!-- Поле + кнопка -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- ПРЕДУПРЕЖДЕНИЕ -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="0"
                       Text="⚠ Не вводите «adb shell». Программа добавляет adb shell автоматически."
                       Foreground="#FFCC66"
                       FontSize="13"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>


                <!-- ================================================= -->
                <!-- ВВОД КОМАНДЫ -->
                <!-- ================================================= -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBox x:Name="AdbCommandTextBox"
                         Grid.Column="0"
                         Height="36"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         Background="#252932"
                         Foreground="White"
                         BorderBrush="#596273"
                         BorderThickness="1"/>


                    <Button Grid.Column="1"
                        Content="Выполнить"
                        Width="110"
                        Height="36"
                        Margin="10,0,0,0"
                        Click="ExecuteAdbCommand_Click"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>