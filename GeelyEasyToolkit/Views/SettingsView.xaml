<UserControl x:Class="GeelyEasyToolkit.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GeelyEasyToolkit.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Настройки"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Основные параметры Geely Easy Toolkit"
                       Margin="0,8,0,0"
                       Foreground="#C8CDD6"
                       FontSize="15"/>

        </StackPanel>


        <!-- Основная область -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- ADB -->

                <Border Background="#3A4050"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="ADB"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Путь к исполняемому файлу adb.exe"
                                   Margin="0,6,0,15"
                                   Foreground="#C8CDD6"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AdbPathTextBox"
                                     Grid.Column="0"
                                     Height="38"
                                     Padding="10"
                                     VerticalContentAlignment="Center"
                                     Background="#252932"
                                     Foreground="White"
                                     BorderBrush="#596273"
                                     BorderThickness="1"/>

                            <Button x:Name="BrowseAdbButton"
                                    Grid.Column="1"
                                    Content="Обзор..."
                                    Width="110"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Click="BrowseAdb_Click"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- APK -->

                <Border Background="#3A4050"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Приложения"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Папка, в которой хранятся APK-файлы"
                                   Margin="0,6,0,15"
                                   Foreground="#C8CDD6"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ApkFolderTextBox"
                                     Grid.Column="0"
                                     Height="38"
                                     Padding="10"
                                     VerticalContentAlignment="Center"
                                     Background="#252932"
                                     Foreground="White"
                                     BorderBrush="#596273"
                                     BorderThickness="1"/>

                            <Button x:Name="BrowseApkButton"
                                    Grid.Column="1"
                                    Content="Обзор..."
                                    Width="110"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Click="BrowseApk_Click"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- Окно -->

                <Border Background="#3A4050"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Окно программы"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Размер и положение окна сохраняются автоматически."
                                   Margin="0,6,0,15"
                                   Foreground="#C8CDD6"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Текущий размер"
                                   Foreground="#9EA5B3"/>

                        <TextBlock x:Name="WindowInfoText"
                                   Text="Автоматически"
                                   Margin="0,4,0,0"
                                   Foreground="White"
                                   FontSize="15"/>

                    </StackPanel>

                </Border>


                <!-- Разработчик -->

                <Border Background="#3A4050"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Разработчик"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Дополнительные технические инструменты."
                                   Margin="0,6,0,15"
                                   Foreground="#C8CDD6"/>

                        <CheckBox x:Name="ShowDeveloperCheckBox"
                                  Content="Показывать раздел «Разработчик»"
                                  Foreground="White"
                                  FontSize="15"
                                  Checked="ShowDeveloperCheckBox_Checked"
                                  Unchecked="ShowDeveloperCheckBox_Unchecked"/>

                        <TextBlock Text="Раздел предназначен для диагностики и технических операций."
                                   Margin="0,8,0,0"
                                   Foreground="#9EA5B3"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- 👇 ДОБАВЛЕНО: СТАТУС СОХРАНЕНИЯ -->
                <Border Background="#252932"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <Button x:Name="SaveSettingsButton"
                                Content="💾 Сохранить настройки"
                                Width="200"
                                Height="40"
                                HorizontalAlignment="Left"
                                Click="SaveSettingsButton_Click"/>

                        <TextBlock x:Name="SaveStatusText"
                                   Text=""
                                   Foreground="LightGreen"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                </Border>


                <!-- Информация -->

                <Border Background="#252932"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Информация"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Geely Easy Toolkit"
                                   Margin="0,10,0,0"
                                   Foreground="#C8CDD6"/>

                        <TextBlock Text="Настройки применяются к текущей конфигурации программы."
                                   Margin="0,5,0,0"
                                   Foreground="#9EA5B3"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>