<UserControl x:Class="GeelyEasyToolkit.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeelyEasyToolkit.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
               Text="Настройки"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,0,0,20"/>

        <!-- Путь к ADB -->

        <TextBlock Grid.Row="1"
               Text="Путь к adb.exe"
               Foreground="White"
               Margin="0,0,0,5"/>

        <DockPanel Grid.Row="2"
               Margin="0,0,0,20">

            <Button x:Name="BrowseAdbButton"
                Content="Обзор..."
                Width="100"
                DockPanel.Dock="Right"
                Click="BrowseAdb_Click"/>

            <TextBox x:Name="AdbPathTextBox"
                 Margin="0,0,10,0"/>

        </DockPanel>

        <!-- Путь к APK -->

        <TextBlock Grid.Row="3"
               Text="Папка с APK"
               Foreground="White"
               Margin="0,0,0,5"/>

        <DockPanel Grid.Row="4">

            <Button x:Name="BrowseApkButton"
                Content="Обзор..."
                Width="100"
                DockPanel.Dock="Right"
                Click="BrowseApk_Click"/>

            <TextBox x:Name="ApkFolderTextBox"
                 Margin="0,0,10,0"/>

        </DockPanel>

    </Grid>
</UserControl>
