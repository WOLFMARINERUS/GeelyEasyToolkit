<UserControl x:Class="GeelyEasyToolkit.Views.RepositoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Локальный репозиторий"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock x:Name="RepositoryPathText"
                       Text="Путь к репозиторию"
                       Margin="0,8,0,0"
                       Foreground="#C8CDD6"/>

        </StackPanel>


        <!-- Панель поиска и сортировки -->

        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="180"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- Поиск -->

            <Grid Grid.Column="0">

                <TextBox x:Name="SearchTextBox"
                         Height="36"
                         Padding="10,5"
                         VerticalContentAlignment="Center"
                         Background="#3A4050"
                         Foreground="White"
                         BorderBrush="#596273"
                         BorderThickness="1"
                         TextChanged="SearchTextBox_TextChanged"/>

                <TextBlock Text="Поиск..."
                           Foreground="#9EA5B3"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>

            </Grid>


            <!-- Сортировка -->

            <ComboBox x:Name="SortComboBox"
                      Grid.Column="1"
                      Height="36"
                      Margin="10,0,0,0"
                      SelectionChanged="SortComboBox_SelectionChanged">

                <ComboBoxItem Content="Имя ↑"
                              Tag="NameAsc"/>

                <ComboBoxItem Content="Имя ↓"
                              Tag="NameDesc"/>

                <ComboBoxItem Content="Package ↑"
                              Tag="PackageAsc"/>

                <ComboBoxItem Content="Package ↓"
                              Tag="PackageDesc"/>

            </ComboBox>

            <!-- Добавить -->
            <Button Grid.Column="2"
        Content="Добавить"
        Width="110"
        Height="36"
        Margin="10,0,0,0"
        Click="AddApplicationButton_Click"/>


            <!-- Обновить -->

            <Button Grid.Column="3"
        Content="Обновить"
        Width="110"
        Height="36"
        Margin="10,0,0,0"
        Click="RefreshButton_Click"/>

            <!-- Открыть папку -->

            <Button Grid.Column="4"
        Content="Открыть папку"
        Width="130"
        Height="36"
        Margin="10,0,0,0"
        Click="OpenFolderButton_Click"/>

        </Grid>


        <!-- Список приложений -->

        <ListView x:Name="RepositoryList"
          Grid.Row="2"
          Background="#2F3440"
          Foreground="White"
          BorderBrush="#596273"
          BorderThickness="1"
          MouseDoubleClick="RepositoryList_MouseDoubleClick">

            <ListView.Resources>

                <!-- Стиль строк как в разделе "Установленные" -->

                <Style TargetType="ListViewItem">

                    <Setter Property="Background"
                    Value="#2F3440"/>

                    <Setter Property="Foreground"
                    Value="White"/>

                    <Setter Property="BorderThickness"
                    Value="0"/>

                    <Setter Property="Padding"
                    Value="5,2"/>

                    <Style.Triggers>

                        <!-- Наведение -->

                        <Trigger Property="IsMouseOver"
                         Value="True">

                            <Setter Property="Background"
                            Value="#3A4050"/>

                        </Trigger>

                        <!-- Выбранная строка -->

                        <Trigger Property="IsSelected"
                         Value="True">

                            <Setter Property="Background"
                            Value="#4A5A7A"/>

                        </Trigger>

                    </Style.Triggers>

                </Style>


                <!-- Заголовки колонок -->

                <Style TargetType="GridViewColumnHeader">

                    <Setter Property="Background"
                    Value="#3A4050"/>

                    <Setter Property="Foreground"
                    Value="White"/>

                    <Setter Property="BorderBrush"
                    Value="#596273"/>

                    <Setter Property="BorderThickness"
                    Value="0,0,1,0"/>

                    <Setter Property="Height"
                    Value="35"/>

                    <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

                    <Setter Property="Padding"
                    Value="10,0"/>

                </Style>

            </ListView.Resources>

            <ListView.View>

                <GridView>

                    <GridViewColumn Header="Название"
                                    Width="220"
                                    DisplayMemberBinding="{Binding Name}"/>

                    <GridViewColumn Header="Категория"
                                    Width="130"
                                    DisplayMemberBinding="{Binding Category}"/>

                    <GridViewColumn Header="Версия"
                                    Width="90"
                                    DisplayMemberBinding="{Binding Version}"/>

                    <GridViewColumn Header="Package"
                                    Width="280"
                                    DisplayMemberBinding="{Binding PackageName}"/>

                    <GridViewColumn Header="APK">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding ApkStatus}"
                                           HorizontalAlignment="Center"/>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                </GridView>

            </ListView.View>

        </ListView>


        <!-- Нижняя строка -->

        <Grid Grid.Row="3"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <TextBlock x:Name="StatusText"
                       Text="Готово"
                       Foreground="#C8CDD6"
                       VerticalAlignment="Center"/>


            <TextBlock x:Name="CountText"
                       Text="Приложений: 0"
                       Foreground="#C8CDD6"
                       VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="480,0,130,0"/>

            <!-- Редактировать -->

            <Button Grid.Column="2"
        Content="Редактировать"
        Width="130"
        Height="32"
        Margin="15,0,0,0"
        Click="EditApplicationButton_Click"/>

        </Grid>

    </Grid>

</UserControl>