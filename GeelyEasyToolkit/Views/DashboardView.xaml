<UserControl x:Class="GeelyEasyToolkit.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#2F3440">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Добро пожаловать!"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Geely Easy Toolkit"
                       FontSize="18"
                       Foreground="LightGray"
                       Margin="0,10,0,30"
                       HorizontalAlignment="Center"/>

            <WrapPanel HorizontalAlignment="Center">

                <Border Width="220"
                        Height="130"
                        Margin="10"
                        Background="#3A4050"
                        CornerRadius="12">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="🚗"
                                   FontSize="36"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Автомобиль"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>
                        

                        <TextBlock x:Name="CarStatusText"
           Text="Не подключен"
           Foreground="Orange"
           HorizontalAlignment="Center"/>

                    </StackPanel>
                
                </Border>
                <Border Width="220"
        Height="130"
        Margin="10"
        Background="#3A4050"
        CornerRadius="12">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="🤖"
                   FontSize="36"
                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Android"
                   Foreground="White"
                   FontSize="18"
                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="AndroidVersionText"
                   Text="-"
                   Foreground="LightGray"
                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>
                <Border Width="220"
        Height="130"
        Margin="10"
        Background="#3A4050"
        CornerRadius="12">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="📱"
                   FontSize="36"
                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Модель"
                   Foreground="White"
                   FontSize="18"
                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CarModelText"
                   Text="-"
                   Foreground="LightGray"
                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>
                <Border Width="220"
                        Height="130"
                        Margin="10"
                        Background="#3A4050"
                        CornerRadius="12">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="📦"
                                   FontSize="36"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Приложения"
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="RepositoryStatusText"
           Text="Репозиторий не выбран"
           Foreground="LightGray"
           HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </WrapPanel>

        </StackPanel>

    </Grid>

</UserControl>