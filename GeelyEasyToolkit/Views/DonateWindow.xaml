<Window x:Class="GeelyEasyToolkit.Views.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поддержать проект"
        Width="600"
        Height="636"
        WindowStartupLocation="CenterOwner"
        Background="#2F3440"
        Foreground="White"
        ResizeMode="NoResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="Поддержать проект"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>


        <StackPanel Grid.Row="1">

            <TextBlock Text="Если программа оказалась полезной и вы хотите поддержать её дальнейшее развитие — спасибо!"
                       FontSize="15"
                       Foreground="#C8CDD6"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>


            <Border Background="#3A4050"
                    CornerRadius="10"
                    Padding="25" Height="72">

                <StackPanel>
                    <TextBlock Text="Спасибо за поддержку!"
                               FontSize="16"
                               Foreground="LightGreen" Height="29"
                               />

                    <!--
                    ЗДЕСЬ ПОЗЖЕ УКАЖЕМ ТВОИ РЕКВИЗИТЫ
                    -->

                </StackPanel>

            </Border>
            <!-- QR-код для поддержки проекта -->

            <Border Background="#3A4050"
        CornerRadius="10"
        Padding="20"
        Margin="0,15,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- QR-код -->

                    <Border Background="White"
                Padding="10"
                CornerRadius="6">

                        <Image x:Name="DonateQrCodeImage"
                   Width="170"
                   Height="170"
                   Stretch="Uniform"/>

                    </Border>


                    <!-- Информация -->

                    <StackPanel Grid.Column="1"
                    Margin="25,0,0,0"
                    VerticalAlignment="Center">

                        <TextBlock Text="Поддержать проект"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="White"/>

                        <TextBlock Text="Отсканируйте QR-код камерой телефона или откройте страницу по кнопке ниже."
                       Foreground="#C8CDD6"
                       TextWrapping="Wrap"
                       Margin="0,10,0,15"/>

                        <Button Content="Открыть страницу поддержки"
                    Width="220"
                    Height="36"
                    HorizontalAlignment="Left"
                    Click="DonateLinkButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </StackPanel>


        <Button Grid.Row="2"
                Content="Закрыть"
                Width="120"
                Height="36"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="CloseButton_Click"/>

    </Grid>


</Window>