<UserControl x:Class="GeelyEasyToolkit.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Профили автомобилей"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Выберите профиль автомобиля для работы программы."
                       Margin="0,8,0,0"
                       Foreground="#C8CDD6"/>

        </StackPanel>


        <!-- Основная область -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Список профилей -->

            <Border Grid.Column="0"
                    Background="#3A4050"
                    CornerRadius="10"
                    Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Доступные профили"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="5,0,5,10"/>

                    <ListBox x:Name="ProfilesList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ProfilesList_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="12"
                                        Margin="0,3"
                                        Background="#252932"
                                        CornerRadius="7">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>

                                        <TextBlock Text="{Binding Manufacturer}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#9EA5B3"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <!-- Информация о профиле -->

            <Border Grid.Column="2"
                    Background="#3A4050"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Информация о профиле"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,20"/>


                    <TextBlock x:Name="ProfileNameText"
                               Text="Автомобиль:"
                               FontSize="16"
                               Foreground="White"
                               Margin="0,5"/>

                    <TextBlock x:Name="ManufacturerText"
                               Text="Производитель:"
                               Foreground="#C8CDD6"
                               Margin="0,5"/>

                    <TextBlock x:Name="AndroidText"
                               Text="Android:"
                               Foreground="#C8CDD6"
                               Margin="0,5"/>

                    <TextBlock x:Name="FirmwareText"
                               Text="Прошивка:"
                               Foreground="#C8CDD6"
                               Margin="0,5"/>

                    <TextBlock x:Name="ConnectionMethodText"
                               Text="Подключение:"
                               Foreground="#C8CDD6"
                               Margin="0,5"/>

                    <TextBlock x:Name="WirelessAdbText"
                               Text="Wireless ADB:"
                               Foreground="#C8CDD6"
                               Margin="0,5"/>

                    <TextBlock x:Name="DeveloperModeText"
                               Text="Режим разработчика:"
                               Foreground="#C8CDD6"
                               Margin="0,5"/>


                    <Separator Margin="0,20"/>


                    <TextBlock x:Name="CurrentProfileText"
                               Text="Профиль не выбран"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#9EA5B3"
                               Margin="0,0,0,15"/>


                    <StackPanel>

                        <Button x:Name="UseProfileButton"
            Content="Использовать этот профиль"
            Width="240"
            Height="40"
            HorizontalAlignment="Left"
            Click="UseProfileButton_Click"/>

                        <StackPanel Orientation="Horizontal"
                Margin="0,10,0,0">

                            <Button Content="Добавить"
                Width="100"
                Height="36"
                Margin="0,0,10,0"
                Click="AddProfileButton_Click"/>

                            <Button Content="Изменить"
                Width="100"
                Height="36"
                Margin="0,0,10,0"
                Click="EditProfileButton_Click"/>

                            <Button Content="Удалить"
                Width="100"
                Height="36"
                Click="DeleteProfileButton_Click"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>


        <!-- Нижняя строка -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">

            <Button Content="Обновить"
                    Width="120"
                    Height="36"
                    Click="RefreshButton_Click"/>

            <TextBlock x:Name="StatusText"
                       Text="Загрузка профилей..."
                       Foreground="#C8CDD6"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

        </StackPanel>

    </Grid>

</UserControl>