<UserControl x:Class="GeelyEasyToolkit.Views.InstalledApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Панель поиска и сортировки -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23*"/>
                <ColumnDefinition Width="583*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     Padding="10,5"
                     VerticalContentAlignment="Center"
                     Background="#3A4050"
                     Foreground="White"
                     BorderBrush="#596273"
                     BorderThickness="1"
                     TextChanged="SearchTextBox_TextChanged" Grid.ColumnSpan="2"/>


            <TextBlock Text="Поиск..."
                       Foreground="#9EA5B3"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" Grid.ColumnSpan="2"/>


            <ComboBox x:Name="SortComboBox"
                      Grid.Column="2"
                      Width="180"
                      Height="36"
                      Margin="10,0,0,0"
                      SelectionChanged="SortComboBox_SelectionChanged">

                <ComboBoxItem Content="Имя ↑"
                              Tag="NameAsc"/>

                <ComboBoxItem Content="Имя ↓"
                              Tag="NameDesc"/>

                <ComboBoxItem Content="Package ↑"
                              Tag="PackageAsc"/>

                <ComboBoxItem Content="Package ↓"
                              Tag="PackageDesc"/>

            </ComboBox>


            <Button Grid.Column="3"
                    x:Name="SelectAllButton"
                    Content="Выбрать все"
                    Width="120"
                    Height="36"
                    Margin="10,0,0,0"
                    Click="SelectAllButton_Click"/>

        </Grid>


        <!-- Список -->

        <ListView x:Name="InstalledAppsList"
                  Grid.Row="1"
                  Background="#2F3440"
                  BorderThickness="0"
                  Foreground="White">

            <ListView.View>

                <GridView>

                    <GridViewColumn Header=""
                                    Width="40">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
          HorizontalAlignment="Center"
          Click="ApplicationCheckBox_Click"/>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>


                    <GridViewColumn Header="Название"
                                    Width="250"
                                    DisplayMemberBinding="{Binding Name}"/>


                    <GridViewColumn Header="Package"
                                    Width="350"
                                    DisplayMemberBinding="{Binding PackageName}"/>


                    <GridViewColumn Header="Версия"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Version}"/>


                    <GridViewColumn Header="Действия"
                                    Width="180">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Запустить"
                                            Width="80"
                                            Height="30"
                                            Margin="0,0,5,0"
                                            Click="Launch_Click"/>

                                    <Button Content="Удалить"
                                            Width="70"
                                            Height="30"
                                            Click="UninstallItem_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                </GridView>

            </ListView.View>

        </ListView>


        <!-- Нижняя панель -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">

            <Button x:Name="RefreshButton"
                    Content="Обновить"
                    Width="120"
                    Height="35"
                    Click="RefreshButton_Click"/>


            <TextBlock x:Name="StatusText"
                       Text="Готово"
                       Foreground="LightGray"
                       VerticalAlignment="Center"
                       Margin="25,0,40,0"/>


            <Button x:Name="DeleteSelectedButton"
                    Content="Удалить выбранные"
                    Width="150"
                    Height="35"
                    Click="UninstallSelected_Click"/>

        </StackPanel>

    </Grid>

</UserControl>