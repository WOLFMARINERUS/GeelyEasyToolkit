<Window x:Class="GeelyEasyToolkit.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль автомобиля"
        Width="500"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#2F3440"
        Foreground="White"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Профиль автомобиля"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Название:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox x:Name="NameTextBox"
                     Grid.Column="1"
                     Height="34"
                     Margin="5"/>

            <TextBlock Grid.Row="1"
                       Text="Производитель:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox x:Name="ManufacturerTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="34"
                     Margin="5"/>

            <TextBlock Grid.Row="2"
                       Text="Android:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox x:Name="AndroidTextBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="34"
                     Margin="5"/>

            <TextBlock Grid.Row="3"
                       Text="Прошивка:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox x:Name="FirmwareTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="34"
                     Margin="5"/>

            <TextBlock Grid.Row="4"
                       Text="Подключение:"
                       VerticalAlignment="Center"
                       Margin="0,5"/>

            <TextBox x:Name="ConnectionTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Height="34"
                     Margin="5"/>

            <CheckBox x:Name="WirelessAdbCheckBox"
                      Grid.Row="5"
                      Grid.ColumnSpan="2"
                      Content="Поддерживает Wireless ADB"
                      Margin="0,12,0,5"/>

            <CheckBox x:Name="DeveloperModeCheckBox"
                      Grid.Row="6"
                      Grid.ColumnSpan="2"
                      Content="Требуется режим разработчика"
                      Margin="0,5"/>

        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Отмена"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Сохранить"
                    Width="120"
                    Height="36"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>