<UserControl x:Class="GeelyEasyToolkit.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ============================================== -->
        <!-- ЗАГОЛОВОК -->
        <!-- ============================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Разработчик"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Технические инструменты и диагностика"
                       Margin="0,10,0,20"
                       Foreground="#C8CDD6"/>

        </StackPanel>


        <!-- ============================================== -->
        <!-- ИНФОРМАЦИЯ О ПРОГРАММЕ -->
        <!-- ============================================== -->

        <Border Grid.Row="1"
                Background="#3A4050"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Версия:"
                           Foreground="#9EA5B3"/>

                <TextBlock x:Name="VersionText"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="-"
                           Foreground="White"/>


                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Профиль:"
                           Foreground="#9EA5B3"/>

                <TextBlock x:Name="ProfileText"
                           Grid.Row="0"
                           Grid.Column="3"
                           Text="-"
                           Foreground="White"/>


                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="ADB:"
                           Margin="0,8,0,0"
                           Foreground="#9EA5B3"/>

                <TextBlock x:Name="AdbStatusText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="-"
                           Margin="0,8,0,0"
                           Foreground="White"/>


                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Репозиторий:"
                           Margin="0,8,0,0"
                           Foreground="#9EA5B3"/>

                <TextBlock x:Name="RepositoryStatusText"
                           Grid.Row="1"
                           Grid.Column="3"
                           Text="-"
                           Margin="0,8,0,0"
                           Foreground="White"/>


                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Устройство:"
                           Margin="0,8,0,0"
                           Foreground="#9EA5B3"/>

                <TextBlock x:Name="DeviceText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Text="-"
                           Margin="0,8,0,0"
                           Foreground="White"/>

            </Grid>

        </Border>


        <!-- ============================================== -->
        <!-- КНОПКИ -->
        <!-- ============================================== -->

        <Grid Grid.Row="2"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Button Grid.Column="0"
                    Content="Проверить ADB"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CheckAdbButton_Click"/>


            <Button Grid.Column="1"
                    Content="Обновить информацию"
                    Width="180"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="RefreshButton_Click"/>


            <Button Grid.Column="2"
                    Content="Очистить журнал"
                    Width="150"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="ClearLogButton_Click"/>


            <Button Grid.Column="3"
                    Content="ADB shell"
                    Width="130"
                    Height="40"
                    Click="FocusCommandButton_Click"/>

        </Grid>


        <!-- ============================================== -->
        <!-- КОНСОЛЬ -->
        <!-- ============================================== -->

        <Border Grid.Row="3"
                Background="#252932"
                BorderBrush="#596273"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="ADB / Developer Console"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>


                <TextBox x:Name="ConsoleOutput"
                         Grid.Row="1"
                         Background="#1E222B"
                         Foreground="#D8DEE9"
                         BorderBrush="#596273"
                         BorderThickness="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>


                <Grid Grid.Row="2"
                      Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <TextBox x:Name="CommandTextBox"
                             Grid.Column="0"
                             Height="38"
                             Padding="10"
                             VerticalContentAlignment="Center"
                             Background="#1E222B"
                             Foreground="White"
                             BorderBrush="#596273"
                             BorderThickness="1"
                             KeyDown="CommandTextBox_KeyDown"/>


                    <Button Grid.Column="1"
                            Content="Выполнить"
                            Width="110"
                            Height="38"
                            Margin="10,0,0,0"
                            Click="ExecuteCommandButton_Click"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>