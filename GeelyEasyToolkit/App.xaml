<Application x:Class="GeelyEasyToolkit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>

            <SolidColorBrush x:Key="AppBackgroundBrush"
                             Color="#2F3440"/>

            <SolidColorBrush x:Key="CardBackgroundBrush"
                             Color="#3A4050"/>

            <SolidColorBrush x:Key="PanelBackgroundBrush"
                             Color="#252932"/>

            <SolidColorBrush x:Key="PrimaryTextBrush"
                             Color="White"/>

            <SolidColorBrush x:Key="SecondaryTextBrush"
                             Color="#C8CDD6"/>


            <!-- Кнопки навигации -->

            <Style x:Key="NavigationButtonStyle"
       TargetType="Button">


                <Setter Property="Background"
            Value="#3A4050"/>


                <Setter Property="Foreground"
            Value="White"/>


                <Setter Property="BorderBrush"
            Value="#596273"/>


                <Setter Property="BorderThickness"
            Value="0"/>


                <Setter Property="Padding"
            Value="14,10"/>


                <Setter Property="Margin"
            Value="0,5,0,5"/>


                <Setter Property="Height"
            Value="42"/>


                <Setter Property="FontSize"
            Value="15"/>


                <Setter Property="FontWeight"
            Value="SemiBold"/>


                <Setter Property="HorizontalContentAlignment"
            Value="Left"/>


                <Setter Property="Cursor"
            Value="Hand"/>


                <Setter Property="Template">


                    <Setter.Value>


                        <ControlTemplate TargetType="Button">


                            <Border x:Name="NavBorder"

                        Background="{TemplateBinding Background}"

                        CornerRadius="8">


                                <ContentPresenter

                        Margin="10,0,0,0"

                        VerticalAlignment="Center"/>


                            </Border>


                            <ControlTemplate.Triggers>


                                <!-- Наведение -->

                                <Trigger Property="IsMouseOver"
                             Value="True">


                                    <Setter TargetName="NavBorder"
                                Property="Background"
                                Value="#465166"/>


                                </Trigger>



                                <!-- Нажатие -->

                                <Trigger Property="IsPressed"
                             Value="True">


                                    <Setter TargetName="NavBorder"
                                Property="Background"
                                Value="#536783"/>


                                </Trigger>


                                <!-- Отключение -->

                                <Trigger Property="IsEnabled"
                             Value="False">


                                    <Setter TargetName="NavBorder"
                                Property="Opacity"
                                Value="0.45"/>


                                </Trigger>


                            </ControlTemplate.Triggers>


                        </ControlTemplate>


                    </Setter.Value>


                </Setter>


            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>