<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1F26"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252932"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2F3440"/>

    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00B4D8"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0096C7"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9CED6"/>

    <!-- Статусы -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC107"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>

</ResourceDictionary>